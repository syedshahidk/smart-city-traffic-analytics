FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    HOME=/tmp

WORKDIR /app

COPY requirements-api.txt /app/requirements-api.txt
RUN python -m pip install --no-cache-dir -r /app/requirements-api.txt

COPY backend /app/backend
COPY analytics/__init__.py analytics/forecasting.py /app/analytics/
COPY analytics/reports /app/analytics/reports
COPY datasets/boundaries /app/datasets/boundaries

USER 10001:10001

EXPOSE 8000
CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
